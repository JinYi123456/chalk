# ===== Chalk — secrets. Copy to .env (gitignored) and fill in what you have. =====
# Every key below is optional. Chalk degrades honestly without each one and
# always tells you which layer answered.

# ── Model provider ────────────────────────────────────────────────────
# provider: ollama (local, default) | google | featherless | nebius | openrouter | custom
CHALK_PROVIDER=ollama
CHALK_MODEL=gemma4:e2b
CHALK_VISION_MODEL=gemma4:e2b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Google AI Studio — free tier serves Gemma (open weights, Apache-2.0)
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=gemma-4-26b-a4b-it

# Featherless AI — hosted open-weight catalog (OpenAI-compatible)
# https://featherless.ai
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# Gemma 4 on AI Studio is text-only; images go to this open-weight vision id.
FEATHERLESS_VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct

# Nebius Token Factory — hosted open-weight catalog (OpenAI-compatible)
# https://nebius.com/services/token-factory
NEBIUS_API_KEY=
NEBIUS_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
NEBIUS_VISION_MODEL=google/gemma-3-27b-it

# OpenRouter — free open-weight tier
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Any other OpenAI-compatible endpoint (llama.cpp, LM Studio, vLLM, ...)
CUSTOM_BASE_URL=
CUSTOM_MODEL=
CUSTOM_API_KEY=

# ── Pricing model (TabPFN) ───────────────────────────────────────────
# Hosted TabPFN-3.5 through Prior Labs' REST API — no torch needed.
# https://platform.priorlabs.ai  (set TABPFN_CLOUD=0 to disable the cloud path)
TABPFN_TOKEN=
# Local TabPFN service (services/tabpfn) — used when the cloud is not configured
TABPFN_URL=http://127.0.0.1:8790

# ── Partner tech (all optional; Chalk is honest about which are absent) ──
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=SAz9YHcvj6GT2YYXdXww
SERPAPI_KEY=
MONGODB_URI=
MONGODB_DB=chalk
SENTRY_DSN=
TINKER_API_KEY=
TINKER_SAMPLER_PATH=
TIGER_URL=

# ── Durable follow-ups (Temporal) ─────────────────────────────────────
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=chalk-followups
# ── App ───────────────────────────────────────────────────────────────
PORT=8787
# Serve the built web app from this process (local/self-hosted). Leave unset on
# Vercel — the platform serves apps/web/dist itself.
SERVE_WEB=1
# Public URL of this deployment; lets follow-up workflows call back.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used automatically.
PUBLIC_BASE_URL=
